{
  "name": "@ds/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue component library. The second backend: Vue bindings, emitter, behaviour primitives.",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./behavior": {
      "types": "./dist/behavior/index.d.ts",
      "import": "./dist/behavior.js",
      "require": "./dist/behavior.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@ds/behavior": "workspace:*",
    "@ds/emit-web": "workspace:*",
    "@ds/platform-web": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "@ds/tokens": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.13"
  }
}
