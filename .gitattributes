# LF in the working tree on every platform.
#
# This is not a style preference — it is load-bearing. `pnpm prop-map:check` asserts that the
# committed .ai/maps/prop-map.{json,md} are BYTE-IDENTICAL to a fresh run. The generator writes
# \n, so if git checked those files out as CRLF on Windows the comparison would fail on a clean
# clone, and the first thing a new contributor would see is a red gate they did not cause.
#
# Determinism is a requirement of every generated artifact here — see the honesty rules in
# CLAUDE.md; line endings are part of that.
* text=auto eol=lf

# Generated by the token build. Not diffed, not reviewed.
packages/tokens/build/** linguist-generated=true

# Generated by `pnpm prop-map`. Collapse in review — the source of truth is
# packages/react/prop-map.config.json plus the component source it measures.
.ai/maps/prop-map.json linguist-generated=true
.ai/maps/prop-map.md   linguist-generated=true

pnpm-lock.yaml -diff linguist-generated=true
