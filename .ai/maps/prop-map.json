    "success": "Confirmation or a completed state. Canonical — never `positive` or `green`.",
    "warning": "Needs attention but is not an error. Canonical — never `caution` or `yellow`.",
    "xs": "Extra small. Canonical — never `xsmall` or `tiny`.",
